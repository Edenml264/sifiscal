---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  activeMenu?: string;
}

const { title, activeMenu = 'dashboard' } = Astro.props;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - SIFiscal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
  <Sidebar activeMenu={activeMenu} user={user} />

  <main class="main-content">
    <header class="bg-white p-3 d-flex justify-content-between align-items-center shadow-sm sticky-top z-1">
      <h1 class="h4 mb-0 text-primary">{title}</h1>
      <div class="d-flex align-items-center gap-3">
        <span class="text-muted small">{user.nombre}</span>
        <a href="/api/auth/logout" class="btn btn-outline-danger btn-sm">Salir</a>
      </div>
    </header>

    <div class="p-4">
      <slot />
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
