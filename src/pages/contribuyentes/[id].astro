                '<tr><td>15% Ingresos:</td><td class="text-end">$' + fmt((d.ingresos_acumulables || 0) * 0.15) + '</td></tr>' +
                '<tr><td><strong>Tope Aplicable:</strong></td><td class="text-end"><strong>$' + fmt(d.tope_deducciones) + '</strong></td></tr>' +
              '</table></div></div></div>' +
            '<div class="col-md-6"><div class="card border-warning"><div class="card-body">' +
              '<h6 class="card-title text-warning">ISR Anual (Art. 152 LISR)</h6>' +
              '<table class="table table-sm mb-0">' +
                '<tr><td>ISR Anual Bruto:</td><td class="text-end">$' + fmt(d.isr_anual_bruto) + '</td></tr>' +
                '<tr><td>Subsidio al Empleo:</td><td class="text-end">$' + fmt(d.subsidio_empleo) + '</td></tr>' +
                '<tr><td>Tasa ISR:</td><td class="text-end">' + (d.tasa_isr * 100).toFixed(2) + '%</td></tr>' +
                '<tr><td>ISR Retenido:</td><td class="text-end">$' + fmt(d.isr_retenido) + '</td></tr>' +
              '</table></div></div></div>' +
            '<div class="col-md-6"><div class="card border-' + saldoColor + '"><div class="card-body">' +
