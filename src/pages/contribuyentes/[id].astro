  function saveDeclaracion() {
    if (!calcularData) { alert('Primero calcula la declaración'); return; }
    var data = Object.assign({}, calcularData, {
      contribuyente_id: contribuyenteId,
      notas: document.getElementById('dcNotas').value || null,
    });
    delete data.num_facturas;

    fetch('/api/declaraciones', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.error) { alert(res.error); return; }
      bsModals.calcular.hide();
      loadDeclaraciones();
      loadCalendario();
    });
  }

  function loadDeclaraciones() {
    var anio = document.getElementById('declAnio').value;
    var tipo = document.getElementById('declTipo').value;
    var params = 'contribuyente_id=' + contribuyenteId;
    if (anio) params += '&anio=' + anio;
    if (tipo) params += '&tipo=' + tipo;

    fetch('/api/declaraciones?' + params)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var tbody = document.getElementById('tablaDeclaraciones');
        if (!data.length) {
          tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No hay declaraciones registradas</td></tr>';
          return;
        }
        tbody.innerHTML = data.map(function(d) {
          var estatusBadge = d.estatus === 'Presentada' ? 'bg-success' : d.estatus === 'Cancelada' ? 'bg-danger' : 'bg-warning text-dark';
          var tipoBadge = d.tipo === 'Anual Sueldos' ? 'bg-info' : d.tipo === 'Anual' ? 'bg-primary' : 'bg-secondary';
          return '<tr>' +
            '<td><strong>' + d.periodo + '</strong></td>' +
            '<td><span class="badge ' + tipoBadge + '">' + d.tipo + '</span></td>' +
            '<td class="text-end">$' + (d.total_ingresos || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</td>' +
            '<td class="text-end">$' + (d.iva_pagar || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</td>' +
            '<td class="text-end">$' + (d.isr_por_pagar || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</td>' +
            '<td><span class="badge ' + estatusBadge + '">' + d.estatus + '</span></td>' +
            '<td>' + (d.fecha_presentacion || '-') + '</td>' +
            '<td class="text-center">' +
              '<button class="btn btn-outline-info btn-sm me-1" onclick="verDetalleDeclaracion(\'' + d.id + '\')" title="Ver">👁️</button>' +
              (d.estatus === 'Borrador' ? '<button class="btn btn-outline-success btn-sm me-1" onclick="openModalPresentar(\'' + d.id + '\')" title="Presentar">✅</button><button class="btn btn-outline-danger btn-sm" onclick="deleteDeclaracion(\'' + d.id + '\')" title="Eliminar">🗑️</button>' : '') +
            '</td></tr>';
        }).join('');
      });
  }

  function verDetalleDeclaracion(id) {
    fetch('/api/declaraciones?id=' + id)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var tipoBadge = d.tipo === 'Anual Sueldos' ? 'bg-info' : d.tipo === 'Anual' ? 'bg-primary' : 'bg-secondary';
        var html = '<div class="row g-3">' +
          '<div class="col-12"><span class="badge ' + tipoBadge + ' me-2">' + d.tipo + '</span><span class="badge ' + (d.estatus === 'Presentada' ? 'bg-success' : d.estatus === 'Cancelada' ? 'bg-danger' : 'bg-warning text-dark') + '">' + d.estatus + '</span></div>' +
          '<div class="col-md-4"><strong>Periodo:</strong><br/>' + d.periodo + '</div>' +
          '<div class="col-md-4"><strong>Presentación:</strong><br/>' + (d.fecha_presentacion || 'N/A') + '</div>' +
          '<div class="col-md-4"><strong>Núm. Operación:</strong><br/>' + (d.numero_operacion || 'N/A') + '</div>';

        if (d.tipo === 'Anual Sueldos') {
          var ingresos = (d.total_ingresos || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var deducciones = (d.isr_retenido || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var baseGravable = (d.base_gravable_isr || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var isrRetenido = (d.isr_retenido || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var isrPorPagar = (d.isr_por_pagar || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var tasa = (d.tasa_isr * 100).toFixed(2);
          html += '<div class="col-12"><hr/><strong class="text-info">Declaración Anual de Sueldos y Salarios (Art. 152 LISR)</strong></div>' +
            '<div class="col-md-6"><strong>Ingresos Acumulables:</strong><br/>$' + ingresos + '</div>' +
            '<div class="col-md-6"><strong>Deducciones Personales:</strong><br/>$' + deducciones + '</div>' +
            '<div class="col-md-6"><strong>Base Gravable:</strong><br/>$' + baseGravable + '</div>' +
            '<div class="col-md-6"><strong>Tasa ISR:</strong><br/>' + tasa + '%</div>' +
            '<div class="col-md-6"><strong>ISR Retenido:</strong><br/>$' + isrRetenido + '</div>' +
            '<div class="col-md-12"><strong>ISR a Pagar / Saldo a Favor:</strong><br/><span class="text-warning fs-5">$' + isrPorPagar + '</span></div>';
        } else {
          var ivaPagar = (d.iva_pagar || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var isrPagar = (d.isr_por_pagar || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          var total = (d.iva_pagar + d.isr_por_pagar).toLocaleString('es-MX', { minimumFractionDigits: 2 });
          html += '<div class="col-md-6"><strong>Total Ingresos:</strong><br/>$' + (d.total_ingresos || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-6"><strong>Total Egresos:</strong><br/>$' + (d.total_egresos || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-6"><strong>IVA Trasladado:</strong><br/>$' + (d.iva_trasladado || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-6"><strong>IVA Acreditado:</strong><br/>$' + (d.iva_acreditado || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-6"><strong>IVA Retenido:</strong><br/>$' + (d.iva_retenido || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-6"><strong>IVA a Pagar:</strong><br/><span class="text-primary fs-5">$' + ivaPagar + '</span></div>' +
            '<div class="col-md-4"><strong>Base Gravable ISR:</strong><br/>$' + (d.base_gravable_isr || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-4"><strong>Tasa ISR:</strong><br/>' + (d.tasa_isr * 100).toFixed(2) + '%</div>' +
            '<div class="col-md-4"><strong>ISR Retenido:</strong><br/>$' + (d.isr_retenido || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + '</div>' +
            '<div class="col-md-12"><strong>ISR a Pagar:</strong><br/><span class="text-warning fs-5">$' + isrPagar + '</span></div>' +
            '<div class="col-12"><hr/><strong>Total a Pagar (IVA + ISR):</strong><br/><span class="text-danger fs-4">$' + total + '</span></div>';
        }

        if (d.notas) html += '<div class="col-12"><strong>Notas:</strong><br/>' + d.notas + '</div>';
        html += '</div>';
        document.getElementById('detalleDeclaracionContent').innerHTML = html;
        bsModals.detalleDecl.show();
      });
  }

  function openModalPresentar(id) {
    document.getElementById('pId').value = id;
    document.getElementById('pFecha').value = new Date().toISOString().split('T')[0];
    document.getElementById('pOperacion').value = '';
    bsModals.presentar.show();
  }

  function confirmarPresentacion() {
    var id = document.getElementById('pId').value;
    fetch('/api/declaraciones', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: id,
        estatus: 'Presentada',
        fecha_presentacion: document.getElementById('pFecha').value,
        numero_operacion: document.getElementById('pOperacion').value,
      }),
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      bsModals.presentar.hide();
      loadDeclaraciones();
      loadCalendario();
    });
  }

  function deleteDeclaracion(id) {
    if (!confirm('¿Eliminar esta declaración?')) return;
    fetch('/api/declaraciones?id=' + id, { method: 'DELETE' })
      .then(function(r) { if (r.ok) { loadDeclaraciones(); loadCalendario(); } });
  }

  // ==================== INICIALIZACIÓN ====================
  document.addEventListener('DOMContentLoaded', function() {
    initModals();
    loadContribuyente();
    loadObligaciones();
    loadEfirma();
    loadDocumentos();
    loadNotas();
    loadFacturas();
    loadDeclaraciones();
    loadCalendario();
  });
</script>
