              '<table class="table table-sm mb-0">' +
                '<tr><td>Ingresos:</td><td class="text-end">$' + fmt(d.total_ingresos) + '</td></tr>' +
                '<tr><td>Egresos:</td><td class="text-end">$' + fmt(d.total_egresos) + '</td></tr>' +
                '<tr><td><strong>Base Gravable:</strong></td><td class="text-end"><strong>$' + fmt(d.base_gravable_isr) + '</strong></td></tr>' +
