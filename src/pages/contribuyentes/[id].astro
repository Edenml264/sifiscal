---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Detalle del Contribuyente" activeMenu="contribuyentes">
  <div class="mb-3">
    <a href="/contribuyentes" class="btn btn-outline-secondary btn-sm">← Volver al listado</a>
  </div>

  <div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0" id="contribNombre">Cargando...</h5>
    </div>
    <div class="card-body" id="contribDetalle">
      <p class="text-center text-muted">Cargando información...</p>
    </div>
  </div>

  <div class="row g-4 mt-2">
    <div class="col-md-4">
      <div class="card">
        <div class="card-header bg-white"><h6 class="mb-0">Obligaciones Fiscales</h6></div>
        <div class="card-body text-center text-muted">Módulo en desarrollo</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-header bg-white"><h6 class="mb-0">Expediente Digital</h6></div>
        <div class="card-body text-center text-muted">Módulo en desarrollo</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-header bg-white"><h6 class="mb-0">Notas y Seguimiento</h6></div>
        <div class="card-body text-center text-muted">Módulo en desarrollo</div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  var contribuyenteId = window.location.pathname.split('/').pop();

  function loadDetalle() {
    fetch('/api/contribuyentes?id=' + contribuyenteId)
      .then(function(r) {
        if (!r.ok) throw new Error('No encontrado');
        return r.json();
      })
      .then(function(c) {
        document.getElementById('contribNombre').textContent = c.nombre + ' (' + c.rfc + ')';
        var badge = c.estatus === 'Activo' ? 'bg-success' : 'bg-danger';
        document.getElementById('contribDetalle').innerHTML =
          '<div class="row g-4">' +
            '<div class="col-md-6">' +
              '<h6 class="text-primary">Datos Generales</h6>' +
              '<table class="table table-sm">' +
                '<tr><td class="fw-bold">Nombre</td><td>' + c.nombre + '</td></tr>' +
                '<tr><td class="fw-bold">RFC</td><td><code>' + c.rfc + '</code></td></tr>' +
                '<tr><td class="fw-bold">CURP</td><td>' + (c.curp || 'N/A') + '</td></tr>' +
                '<tr><td class="fw-bold">Régimen</td><td>' + c.regimen_fiscal + '</td></tr>' +
                '<tr><td class="fw-bold">Estatus</td><td><span class="badge ' + badge + '">' + c.estatus + '</span></td></tr>' +
              '</table>' +
            '</div>' +
            '<div class="col-md-6">' +
              '<h6 class="text-primary">Contacto</h6>' +
              '<table class="table table-sm">' +
                '<tr><td class="fw-bold">Domicilio</td><td>' + (c.domicilio || 'N/A') + '</td></tr>' +
                '<tr><td class="fw-bold">Correo</td><td>' + (c.correo || 'N/A') + '</td></tr>' +
                '<tr><td class="fw-bold">Teléfono</td><td>' + (c.telefono || 'N/A') + '</td></tr>' +
                '<tr><td class="fw-bold">Contacto</td><td>' + (c.contacto || 'N/A') + '</td></tr>' +
              '</table>' +
            '</div>' +
          '</div>';
      })
      .catch(function() {
        document.getElementById('contribDetalle').innerHTML = '<div class="alert alert-danger">Contribuyente no encontrado</div>';
      });
  }

  loadDetalle();
</script>
