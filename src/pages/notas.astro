---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Notas y Seguimiento">
  <div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0"><i class="bi bi-journal-text me-2"></i>Notas y Seguimiento</h1>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#notaModal" onclick="resetForm()">
        <i class="bi bi-plus-lg me-1"></i>Nueva Nota
      </button>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label">Contribuyente</label>
            <select id="filterContribuyente" class="form-select">
              <option value="">Todos</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Tipo</label>
            <select id="filterTipo" class="form-select">
              <option value="">Todos</option>
              <option value="Nota">Nota</option>
              <option value="Pendiente">Pendiente</option>
              <option value="Observación">Observación</option>
              <option value="Historial">Historial</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Estatus</label>
            <select id="filterEstatus" class="form-select">
              <option value="">Todos</option>
              <option value="Activo">Activo</option>
              <option value="Completado">Completado</option>
              <option value="Cancelado">Cancelado</option>
            </select>
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <button id="btnBuscar" class="btn btn-outline-primary w-100">Buscar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de notas -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul me-1"></i>Notas</span>
        <span id="totalNotas" class="badge bg-primary">0</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Tipo</th>
                <th>Título</th>
                <th>Contribuyente</th>
                <th>Estatus</th>
                <th>Fecha</th>
                <th class="text-center" style="width: 140px;">Acciones</th>
              </tr>
            </thead>
            <tbody id="notasTable">
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">Cargando notas...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Nueva/Editar Nota -->
  <div class="modal fade" id="notaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="notaModalTitle">Nueva Nota</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="notaForm">
            <input type="hidden" id="notaId" />
            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label">Tipo <span class="text-danger">*</span></label>
                <select id="notaTipo" class="form-select" required>
                  <option value="">Seleccionar tipo</option>
                  <option value="Nota">Nota</option>
                  <option value="Pendiente">Pendiente</option>
                  <option value="Observación">Observación</option>
                  <option value="Historial">Historial</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Estatus</label>
                <select id="notaEstatus" class="form-select">
                  <option value="Activo">Activo</option>
                  <option value="Completado">Completado</option>
                  <option value="Cancelado">Cancelado</option>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Contribuyente</label>
              <select id="notaContribuyente" class="form-select">
                <option value="">Sin contribuyente</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Título <span class="text-danger">*</span></label>
              <input type="text" id="notaTitulo" class="form-control" placeholder="Título de la nota" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Contenido <span class="text-danger">*</span></label>
              <textarea id="notaContenido" class="form-control" rows="5" placeholder="Escribe el contenido de la nota..." required></textarea>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" id="btnGuardar" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Guardar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Ver Nota -->
  <div class="modal fade" id="viewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="viewModalTitle">Detalle de Nota</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="viewModalBody">
          <p class="text-muted">Cargando...</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  let contribuyentes = [];
  let notas = [];
  let editingId = null;

  document.addEventListener('DOMContentLoaded', function() {
    loadContribuyentes();
    loadNotas();
  });

  async function loadContribuyentes() {
    try {
      const res = await fetch('/api/contribuyentes');
      contribuyentes = await res.json();
      const options = contribuyentes.map(c => '<option value="' + c.id + '">' + c.nombre + ' (' + c.rfc + ')</option>').join('');
      document.getElementById('filterContribuyente').innerHTML = '<option value="">Todos</option>' + options;
      document.getElementById('notaContribuyente').innerHTML = '<option value="">Sin contribuyente</option>' + options;
    } catch (e) {
      console.error('Error loading contribuyentes:', e);
    }
  }

  async function loadNotas() {
    try {
      const contribuyenteId = document.getElementById('filterContribuyente').value;
      const tipo = document.getElementById('filterTipo').value;
      const estatus = document.getElementById('filterEstatus').value;
      let url = '/api/notas?';
      if (contribuyenteId) url += 'contribuyente_id=' + contribuyenteId + '&';
      if (tipo) url += 'tipo=' + tipo + '&';
      if (estatus) url += 'estatus=' + estatus;

      const res = await fetch(url);
      notas = await res.json();
      renderTable();
    } catch (e) {
      console.error('Error loading notas:', e);
    }
  }

  function renderTable() {
    const tbody = document.getElementById('notasTable');
    document.getElementById('totalNotas').textContent = notas.length;

    if (notas.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No se encontraron notas</td></tr>';
      return;
    }

    tbody.innerHTML = notas.map(function(nota) {
      const fecha = new Date(nota.created_at).toLocaleDateString('es-MX');
      const tipoBadge = getTipoBadge(nota.tipo);
      const estatusBadge = getEstatusBadge(nota.estatus);
      const contribuyente = nota.contribuyente_nombre ? nota.contribuyente_nombre : '<span class="text-muted">General</span>';

      return '<tr>' +
        '<td>' + tipoBadge + '</td>' +
        '<td><strong>' + nota.titulo + '</strong></td>' +
        '<td>' + contribuyente + '</td>' +
        '<td>' + estatusBadge + '</td>' +
        '<td>' + fecha + '</td>' +
        '<td class="text-center">' +
          '<button class="btn btn-sm btn-outline-info me-1" onclick="viewNota(\'' + nota.id + '\')" title="Ver"><i class="bi bi-eye"></i></button>' +
          '<button class="btn btn-sm btn-outline-warning me-1" onclick="editNota(\'' + nota.id + '\')" title="Editar"><i class="bi bi-pencil"></i></button>' +
          '<button class="btn btn-sm btn-outline-danger" onclick="deleteNota(\'' + nota.id + '\')" title="Eliminar"><i class="bi bi-trash"></i></button>' +
        '</td>' +
      '</tr>';
    }).join('');
  }

  function getTipoBadge(tipo) {
    const colors = {
      'Nota': 'bg-primary',
      'Pendiente': 'bg-warning text-dark',
      'Observación': 'bg-info',
      'Historial': 'bg-secondary',
    };
    return '<span class="badge ' + (colors[tipo] || 'bg-secondary') + '">' + tipo + '</span>';
  }

  function getEstatusBadge(estatus) {
    const colors = {
      'Activo': 'bg-success',
      'Completado': 'bg-secondary',
      'Cancelado': 'bg-danger',
    };
    return '<span class="badge ' + (colors[estatus] || 'bg-secondary') + '">' + estatus + '</span>';
  }

  function resetForm() {
    editingId = null;
    document.getElementById('notaId').value = '';
    document.getElementById('notaTipo').value = '';
    document.getElementById('notaEstatus').value = 'Activo';
    document.getElementById('notaContribuyente').value = '';
    document.getElementById('notaTitulo').value = '';
    document.getElementById('notaContenido').value = '';
    document.getElementById('notaModalTitle').textContent = 'Nueva Nota';
  }

  async function editNota(id) {
    try {
      const res = await fetch('/api/notas?id=' + id);
      const nota = await res.json();
      editingId = id;
      document.getElementById('notaId').value = id;
      document.getElementById('notaTipo').value = nota.tipo;
      document.getElementById('notaEstatus').value = nota.estatus;
      document.getElementById('notaContribuyente').value = nota.contribuyente_id || '';
      document.getElementById('notaTitulo').value = nota.titulo;
      document.getElementById('notaContenido').value = nota.contenido;
      document.getElementById('notaModalTitle').textContent = 'Editar Nota';
      new bootstrap.Modal(document.getElementById('notaModal')).show();
    } catch (e) {
      alert('Error al cargar nota');
    }
  }

  async function viewNota(id) {
    try {
      const res = await fetch('/api/notas?id=' + id);
      const nota = await res.json();
      const fecha = new Date(nota.created_at).toLocaleString('es-MX');
      const contribuyente = nota.contribuyente_nombre ? nota.contribuyente_nombre + ' (' + nota.contribuyente_rfc + ')' : 'General';

      document.getElementById('viewModalTitle').textContent = nota.titulo;
      document.getElementById('viewModalBody').innerHTML =
        '<div class="mb-3">' +
          '<strong>Tipo:</strong> ' + getTipoBadge(nota.tipo) + ' ' +
          '<strong class="ms-3">Estatus:</strong> ' + getEstatusBadge(nota.estatus) +
        '</div>' +
        '<div class="mb-3"><strong>Contribuyente:</strong> ' + contribuyente + '</div>' +
        '<div class="mb-3"><strong>Fecha:</strong> ' + fecha + '</div>' +
        '<hr>' +
        '<div class="p-3 bg-light rounded">' + nota.contenido.replace(/\n/g, '<br>') + '</div>';

      new bootstrap.Modal(document.getElementById('viewModal')).show();
    } catch (e) {
      alert('Error al cargar nota');
    }
  }

  document.getElementById('btnGuardar').addEventListener('click', async function() {
    const tipo = document.getElementById('notaTipo').value;
    const titulo = document.getElementById('notaTitulo').value;
    const contenido = document.getElementById('notaContenido').value;
    const estatus = document.getElementById('notaEstatus').value;
    const contribuyenteId = document.getElementById('notaContribuyente').value;

    if (!tipo || !titulo || !contenido) {
      alert('Tipo, título y contenido son obligatorios');
      return;
    }

    const body = {
      contribuyente_id: contribuyenteId || null,
      tipo: tipo,
      titulo: titulo,
      contenido: contenido,
      estatus: estatus,
    };

    try {
      let res;
      if (editingId) {
        body.id = editingId;
        res = await fetch('/api/notas', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
      } else {
        res = await fetch('/api/notas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
      }
      const data = await res.json();
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('notaModal')).hide();
        resetForm();
        loadNotas();
      } else {
        alert(data.error || 'Error al guardar');
      }
    } catch (e) {
      alert('Error de conexión');
    }
  });

  document.getElementById('btnBuscar').addEventListener('click', loadNotas);

  async function deleteNota(id) {
    if (!confirm('¿Estás seguro de eliminar esta nota?')) return;
    try {
      const res = await fetch('/api/notas?id=' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        loadNotas();
      } else {
        alert(data.error || 'Error al eliminar');
      }
    } catch (e) {
      alert('Error de conexión');
    }
  }
</script>
