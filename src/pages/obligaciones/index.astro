---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const TIPOS = [
  'ISR', 'IVA', 'Retenciones', 'Declaración Mensual', 'Declaración Anual',
  'DIOT', 'Informativas', 'Avisos al RFC', 'Contabilidad Electrónica', 'Otras'
];
---

<DashboardLayout title="Obligaciones Fiscales" activeMenu="obligaciones">
  <div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Control de Obligaciones Fiscales</h5>
      <button class="btn btn-primary" onclick="openModal()">+ Nueva Obligación</button>
    </div>

    <div class="card-body">
      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <select class="form-select" id="filterContribuyente" onchange="loadObligaciones()">
            <option value="">Todos los contribuyentes</option>
          </select>
        </div>
        <div class="col-md-4">
          <select class="form-select" id="filterTipo" onchange="loadObligaciones()">
            <option value="">Todos los tipos</option>
            {TIPOS.map(t => <option value={t}>{t}</option>)}
          </select>
        </div>
        <div class="col-md-4">
          <select class="form-select" id="filterEstatus" onchange="loadObligaciones()">
            <option value="">Todos los estatus</option>
            <option value="Pendiente">Pendiente</option>
            <option value="Presentada">Presentada</option>
            <option value="Vencida">Vencida</option>
            <option value="No Aplica">No Aplica</option>
          </select>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Contribuyente</th>
              <th>Tipo</th>
              <th>Periodo</th>
              <th>Vencimiento</th>
              <th>Estatus</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody id="tablaObligaciones">
            <tr><td colspan="6" class="text-center text-muted">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Obligación -->
  <div class="modal fade" id="modalObligacion" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Nueva Obligación</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="obligacionForm">
            <input type="hidden" id="oId" />
            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label">Contribuyente *</label>
                <select class="form-select" id="oContribuyente" required></select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Tipo de Obligación *</label>
                <select class="form-select" id="oTipo" required>
                  {TIPOS.map(t => <option value={t}>{t}</option>)}
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Periodo</label>
                <input type="text" class="form-control" id="oPeriodo" placeholder="Ej: Enero 2026" />
              </div>
              <div class="col-md-6">
                <label class="form-label">Fecha de Vencimiento *</label>
                <input type="date" class="form-control" id="oVencimiento" required />
              </div>
              <div class="col-md-4">
                <label class="form-label">Estatus</label>
                <select class="form-select" id="oEstatus">
                  <option value="Pendiente">Pendiente</option>
                  <option value="Presentada">Presentada</option>
                  <option value="Vencida">Vencida</option>
                  <option value="No Aplica">No Aplica</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Fecha Presentación</label>
                <input type="date" class="form-control" id="oFechaPresentacion" />
              </div>
              <div class="col-md-4">
                <label class="form-label">Nº Operación</label>
                <input type="text" class="form-control" id="oOperacion" />
              </div>
              <div class="col-12">
                <label class="form-label">Notas</label>
                <textarea class="form-control" id="oNotas" rows="2"></textarea>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary" onclick="saveObligacion()">Guardar</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  var bsModal = null;

  function initModal() {
    bsModal = new bootstrap.Modal(document.getElementById('modalObligacion'));
    loadContribuyentesSelect();
    loadObligaciones();
  }

  function loadContribuyentesSelect() {
    fetch('/api/contribuyentes')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var sel = document.getElementById('oContribuyente');
        sel.innerHTML = '<option value="">Seleccionar contribuyente</option>';
        data.forEach(function(c) {
          sel.innerHTML += '<option value="' + c.id + '">' + c.nombre + ' (' + c.rfc + ')</option>';
        });

        var filterSel = document.getElementById('filterContribuyente');
        filterSel.innerHTML = '<option value="">Todos los contribuyentes</option>';
        data.forEach(function(c) {
          filterSel.innerHTML += '<option value="' + c.id + '">' + c.nombre + '</option>';
        });
      });
  }

  function loadObligaciones() {
    var contribuyenteId = document.getElementById('filterContribuyente').value;
    var tipo = document.getElementById('filterTipo').value;
    var estatus = document.getElementById('filterEstatus').value;
    var params = new URLSearchParams();
    if (contribuyenteId) params.set('contribuyente_id', contribuyenteId);
    if (tipo) params.set('tipo', tipo);
    if (estatus) params.set('estatus', estatus);

    fetch('/api/obligaciones?' + params)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var tbody = document.getElementById('tablaObligaciones');
        if (!data.length) {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No hay obligaciones registradas</td></tr>';
          return;
        }
        tbody.innerHTML = data.map(function(o) {
          var badge = 'bg-secondary';
          if (o.estatus === 'Pendiente') badge = 'bg-warning text-dark';
          else if (o.estatus === 'Presentada') badge = 'bg-success';
          else if (o.estatus === 'Vencida') badge = 'bg-danger';

          var vencClass = '';
          if (o.estatus === 'Pendiente') {
            var hoy = new Date();
            var ven = new Date(o.fecha_vencimiento);
            var diff = Math.ceil((ven - hoy) / (1000 * 60 * 60 * 24));
            if (diff < 0) vencClass = 'text-danger fw-bold';
            else if (diff <= 7) vencClass = 'text-danger';
            else if (diff <= 30) vencClass = 'text-warning';
          }

          return '<tr>' +
            '<td><strong>' + o.contribuyente_nombre + '</strong><br/><small class="text-muted">' + o.contribuyente_rfc + '</small></td>' +
            '<td>' + o.tipo + '</td>' +
            '<td>' + (o.periodo || '-') + '</td>' +
            '<td class="' + vencClass + '">' + o.fecha_vencimiento + '</td>' +
            '<td><span class="badge ' + badge + '">' + o.estatus + '</span></td>' +
            '<td class="text-end">' +
              '<button class="btn btn-outline-warning btn-sm me-1" onclick="editObligacion(\'' + o.id + '\')" title="Editar">✏️</button>' +
              '<button class="btn btn-outline-danger btn-sm" onclick="deleteObligacion(\'' + o.id + '\')" title="Eliminar">🗑️</button>' +
            '</td></tr>';
        }).join('');
      })
      .catch(function(e) { console.error('Error:', e); });
  }

  function openModal() {
    document.getElementById('oId').value = '';
    document.getElementById('oContribuyente').selectedIndex = 0;
    document.getElementById('oTipo').selectedIndex = 0;
    document.getElementById('oPeriodo').value = '';
    document.getElementById('oVencimiento').value = '';
    document.getElementById('oEstatus').selectedIndex = 0;
    document.getElementById('oFechaPresentacion').value = '';
    document.getElementById('oOperacion').value = '';
    document.getElementById('oNotas').value = '';
    document.getElementById('modalTitle').textContent = 'Nueva Obligación';
    bsModal.show();
  }

  function editObligacion(id) {
    fetch('/api/obligaciones?id=' + id)
      .then(function(r) { return r.json(); })
      .then(function(o) {
        document.getElementById('oId').value = o.id;
        document.getElementById('oContribuyente').value = o.contribuyente_id;
        document.getElementById('oTipo').value = o.tipo;
        document.getElementById('oPeriodo').value = o.periodo || '';
        document.getElementById('oVencimiento').value = o.fecha_vencimiento;
        document.getElementById('oEstatus').value = o.estatus;
        document.getElementById('oFechaPresentacion').value = o.fecha_presentacion || '';
        document.getElementById('oOperacion').value = o.numero_operacion || '';
        document.getElementById('oNotas').value = o.notas || '';
        document.getElementById('modalTitle').textContent = 'Editar Obligación';
        bsModal.show();
      })
      .catch(function() { alert('Error al cargar'); });
  }

  function saveObligacion() {
    var id = document.getElementById('oId').value;
    var data = {
      id: id || undefined,
      contribuyente_id: document.getElementById('oContribuyente').value,
      tipo: document.getElementById('oTipo').value,
      periodo: document.getElementById('oPeriodo').value,
      fecha_vencimiento: document.getElementById('oVencimiento').value,
      estatus: document.getElementById('oEstatus').value,
      fecha_presentacion: document.getElementById('oFechaPresentacion').value || null,
      numero_operacion: document.getElementById('oOperacion').value,
      notas: document.getElementById('oNotas').value,
    };
    if (!data.contribuyente_id || !data.tipo || !data.fecha_vencimiento) {
      alert('Contribuyente, tipo y vencimiento son obligatorios');
      return;
    }

    var method = id ? 'PUT' : 'POST';
    fetch('/api/obligaciones', {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
    .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
    .then(function(res) {
      if (!res.ok) { alert(res.data.error || 'Error'); return; }
      bsModal.hide();
      loadObligaciones();
    })
    .catch(function() { alert('Error al guardar'); });
  }

  function deleteObligacion(id) {
    if (!confirm('¿Eliminar esta obligación?')) return;
    fetch('/api/obligaciones?id=' + id, { method: 'DELETE' })
      .then(function(r) { if (r.ok) loadObligaciones(); else alert('Error'); });
  }

  document.addEventListener('DOMContentLoaded', initModal);
</script>
