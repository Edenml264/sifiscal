---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Respaldos">
  <div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0"><i class="bi bi-cloud-download me-2"></i>Respaldos</h1>
    </div>

    <!-- Acciones principales -->
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body text-center">
            <i class="bi bi-download display-4 text-primary mb-3"></i>
            <h5 class="card-title">Exportar Respaldo</h5>
            <p class="card-text text-muted">Descarga un archivo JSON con todos los datos del sistema (contribuyentes, obligaciones, notas, etc.)</p>
            <button id="btnExportar" class="btn btn-primary btn-lg">
              <i class="bi bi-cloud-download me-1"></i>Exportar Datos
            </button>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body text-center">
            <i class="bi bi-upload display-4 text-success mb-3"></i>
            <h5 class="card-title">Importar Respaldo</h5>
            <p class="card-text text-muted">Restaura datos desde un archivo JSON de respaldo anterior. Los datos se combinarán con los existentes.</p>
            <input type="file" id="fileImport" accept=".json" class="d-none" />
            <button id="btnImportar" class="btn btn-success btn-lg">
              <i class="bi bi-cloud-upload me-1"></i>Importar Datos
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Advertencia -->
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle me-2"></i>
      <strong>Importante:</strong> La importación de respaldos no sobrescribe datos existentes, los combina. Se recomienda exportar un respaldo antes de importar.
    </div>

    <!-- Historial de respaldos -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i>Historial de Respaldos</span>
        <span id="totalRespaldos" class="badge bg-primary">0</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Usuario</th>
                <th>Tamaño</th>
                <th class="text-center" style="width: 80px;">Acciones</th>
              </tr>
            </thead>
            <tbody id="respaldosTable">
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">Cargando historial...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  let respaldos = [];

  document.addEventListener('DOMContentLoaded', function() {
    loadRespaldos();
  });

  async function loadRespaldos() {
    try {
      const res = await fetch('/api/respaldos');
      respaldos = await res.json();
      renderTable();
    } catch (e) {
      console.error('Error loading respaldos:', e);
    }
  }

  function renderTable() {
    const tbody = document.getElementById('respaldosTable');
    document.getElementById('totalRespaldos').textContent = respaldos.length;

    if (respaldos.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No hay respaldos registrados</td></tr>';
      return;
    }

    tbody.innerHTML = respaldos.map(function(r) {
      const fecha = new Date(r.created_at).toLocaleString('es-MX');
      const tipoBadge = r.tipo === 'Exportación' ? 'bg-primary' : 'bg-success';
      return '<tr>' +
        '<td>' + fecha + '</td>' +
        '<td><span class="badge ' + tipoBadge + '">' + r.tipo + '</span></td>' +
        '<td>' + (r.usuario_nombre || 'Sistema') + '</td>' +
        '<td>' + (r.tamano || '-') + '</td>' +
        '<td class="text-center">' +
          '<button class="btn btn-sm btn-outline-danger" onclick="deleteRespaldo(\'' + r.id + '\')" title="Eliminar registro"><i class="bi bi-trash"></i></button>' +
        '</td>' +
      '</tr>';
    }).join('');
  }

  document.getElementById('btnExportar').addEventListener('click', async function() {
    const btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Exportando...';

    try {
      const res = await fetch('/api/respaldos?action=export');
      if (!res.ok) throw new Error('Error al exportar');

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'sifiscal-backup-' + new Date().toISOString().split('T')[0] + '.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      loadRespaldos();
    } catch (e) {
      alert('Error al exportar respaldo');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-cloud-download me-1"></i>Exportar Datos';
    }
  });

  document.getElementById('btnImportar').addEventListener('click', function() {
    document.getElementById('fileImport').click();
  });

  document.getElementById('fileImport').addEventListener('change', async function(e) {
    const file = e.target.files[0];
    if (!file) return;

    if (!confirm('¿Estás seguro de importar este respaldo? Los datos se combinarán con los existentes.')) {
      this.value = '';
      return;
    }

    try {
      const text = await file.text();
      const data = JSON.parse(text);

      if (!data.datos) {
        alert('Archivo de respaldo no válido');
        return;
      }

      const res = await fetch('/api/respaldos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ datos: data.datos }),
      });
      const result = await res.json();

      if (result.success) {
        alert('Respaldo importado exitosamente. Registros importados: ' + result.imported);
        loadRespaldos();
      } else {
        alert(result.error || 'Error al importar');
      }
    } catch (e) {
      alert('Error al leer el archivo');
    }

    this.value = '';
  });

  async function deleteRespaldo(id) {
    if (!confirm('¿Eliminar este registro del historial?')) return;
    try {
      const res = await fetch('/api/respaldos?id=' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        loadRespaldos();
      }
    } catch (e) {
      alert('Error al eliminar');
    }
  }
</script>
